# Handle line endings automatically for files detected as text
# and perform LF normalization (convert CRLF to LF on commit)
* text=auto

# Explicitly declare text files you want to always be LF or CRLF
# Since we use Docker, LF is safer and more consistent
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.py text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.example text eol=lf
.gitignore text eol=lf
.env* text eol=lf
Dockerfile* text eol=lf

# Denote all files that are truly binary and should not be modified.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
